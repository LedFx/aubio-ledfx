{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "aubio-ledfx",
  "version-string": "0.4.11",
  "description": "aubio is a library for audio and music analysis, synthesis, and effects",
  "builtin-baseline": "173a20135d7daa83d048d25f50506b6eba8c0d5e",
  "dependencies": [
    "pkgconf",
    {
      "name": "libsndfile",
      "default-features": false,
      "features": ["external-libs"]
    },
    "libsamplerate",
    {
      "name": "mpg123",
      "platform": "linux"
    },
    {
      "name": "mp3lame",
      "platform": "linux"
    },
    {
      "name": "opus",
      "platform": "linux"
    },
    {
      "name": "libogg",
      "platform": "linux"
    },
    {
      "name": "libvorbis",
      "platform": "linux"
    },
    {
      "name": "libflac",
      "platform": "linux"
    },
    {
      "name": "rubberband",
      "platform": "!linux"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "swresample"],
      "platform": "!linux"
    }
  ],
  "overrides": [
    {
      "$comment": "Keep FFmpeg 8: the baseline's FFmpeg 9 is a major API change, to move to separately",
      "name": "ffmpeg",
      "version": "8.1.2",
      "port-version": 3
    },
    {
      "name": "ffmpeg-bin2c",
      "version": "8.1.1"
    }
  ]
}
